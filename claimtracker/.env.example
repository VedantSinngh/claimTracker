# ─── Application ────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Database ────────────────────────────────────────────────────
# Production (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://claimuser:claimpass@postgres:5432/claimtracker
# Local dev override (SQLite, same models)
# DATABASE_URL=sqlite+aiosqlite:///./claimtracker_dev.db

# ─── Groq AI ─────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama3-70b-8192

# ─── Embeddings ──────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
FAISS_INDEX_DIR=./faiss_index

# ─── RAG ─────────────────────────────────────────────────────────
RAG_TOP_K=5
CONFIDENCE_THRESHOLD=0.70

# ─── OCR ─────────────────────────────────────────────────────────
TESSERACT_CMD=/usr/bin/tesseract

# ─── File uploads ────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# ─── n8n ─────────────────────────────────────────────────────────
N8N_WEBHOOK_URL=http://n8n:5678/webhook/claim-decided

# ─── CORS ────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
